modules = ["nodejs-24"]

[[artifacts]]
id = "artifacts/api-server"

[[artifacts]]
id = "artifacts/mockup-sandbox"

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"

[userenv]

# [userenv.shared] removed 2026-08-04 — secrets must live in Vercel/Replit env vars, never in a tracked file.
# Required env vars: CONTACT_TO_EMAIL, CONTACT_FROM_EMAIL, ADMIN_PASSWORD, RESEND_API_KEY